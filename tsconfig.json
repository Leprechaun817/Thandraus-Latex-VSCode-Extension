{
	"compilerOptions": {
		"target": "ES2025",
		"module": "node16",
		"lib": ["ES2025"],
		"moduleResolution": "node16",
		"rootDir": "src",
		"outDir": "out",
		"sourceMap": true,
		"strict": true,
		"types": ["node", "vscode"],
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", ".vscode-test"]
}